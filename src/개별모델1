def get_model_rows(
    df
):
    if TRAIN_ONLY_OFFICIAL_RANGE:
        return df.loc[
            df["target_cf"]
            >= OFFICIAL_MIN_CF
        ].copy()

    return df.copy()


# ============================================================
# 5. 학습 가중치 생성
# ============================================================

def make_output_weights(
    target_cf,
    scheme
):
    """
    실제 발전량 CF 구간별 sample_weight 생성.

    반환 가중치는 평균 1로 정규화하지만
    구간 간 상대적 비율은 그대로 유지합니다.
    """

    cf = np.asarray(
        target_cf,
        dtype=float
    )

    weights = np.full(
        len(cf),
        scheme["below_50"],
        dtype=float
    )

    weights[
        (cf >= 0.50)
        & (cf < 0.70)
    ] = scheme["cf_50_70"]

    weights[
        (cf >= 0.70)
        & (cf < 0.90)
    ] = scheme["cf_70_90"]

    weights[
        cf >= 0.90
    ] = scheme["above_90"]

    weights = (
        weights
        / weights.mean()
    )

    return weights


def make_equal_group_weights(
    group_ids
):
    """
    글로벌 모델에서 각 그룹의 총 가중치가
    동일해지도록 그룹별 표본 수를 보정합니다.
    """

    group_series = pd.Series(
        group_ids
    ).reset_index(drop=True)

    group_counts = (
        group_series
        .value_counts()
    )

    weights = group_series.map(
        lambda group_id:
        1.0 / group_counts.loc[group_id]
    ).to_numpy(dtype=float)

    weights = (
        weights
        / weights.mean()
    )

    return weights


