def load_group_data(
    group_id,
    config
):
    train_path = find_file(
        config["train_filename"]
    )

    test_path = find_file(
        config["test_filename"]
    )

    train_df = pd.read_csv(
        train_path,
        encoding="utf-8-sig"
    )

    test_df = pd.read_csv(
        test_path,
        encoding="utf-8-sig"
    )

    target_col = config["target_col"]
    capacity_kwh = config["capacity_kwh"]

    # --------------------------------------------------------
    # 필수 컬럼 확인
    # --------------------------------------------------------

    if TIME_COL not in train_df.columns:
        raise KeyError(
            f"Group {group_id} Train에 "
            f"'{TIME_COL}' 컬럼이 없습니다."
        )

    if TIME_COL not in test_df.columns:
        raise KeyError(
            f"Group {group_id} Test에 "
            f"'{TIME_COL}' 컬럼이 없습니다."
        )

    if target_col not in train_df.columns:
        raise KeyError(
            f"Group {group_id} Train에 "
            f"'{target_col}' 컬럼이 없습니다."
        )

    # --------------------------------------------------------
    # 시간 변환 및 정렬
    # --------------------------------------------------------

    train_df[TIME_COL] = pd.to_datetime(
        train_df[TIME_COL],
        errors="raise"
    )

    test_df[TIME_COL] = pd.to_datetime(
        test_df[TIME_COL],
        errors="raise"
    )

    train_df = (
        train_df
        .sort_values(TIME_COL)
        .reset_index(drop=True)
    )

    test_df = (
        test_df
        .sort_values(TIME_COL)
        .reset_index(drop=True)
    )

    # --------------------------------------------------------
    # 중복 시각 확인
    # --------------------------------------------------------

    if train_df[TIME_COL].duplicated().any():
        raise ValueError(
            f"Group {group_id} Train에 "
            "중복된 예측 시각이 있습니다."
        )

    if test_df[TIME_COL].duplicated().any():
        raise ValueError(
            f"Group {group_id} Test에 "
            "중복된 예측 시각이 있습니다."
        )

    # --------------------------------------------------------
    # 타깃 정리
    # --------------------------------------------------------

    train_df[target_col] = pd.to_numeric(
        train_df[target_col],
        errors="coerce"
    )

    # Group 3의 제공되지 않은 과거 구간 등이 있다면 제거
    train_df = train_df.loc[
        train_df[target_col].notna()
    ].copy()

    if train_df.empty:
        raise ValueError(
            f"Group {group_id}의 유효한 Train 행이 없습니다."
        )

    if np.isinf(
        train_df[target_col].to_numpy()
    ).any():
        raise ValueError(
            f"Group {group_id} 타깃에 무한대가 있습니다."
        )

    train_df["target_cf"] = (
        train_df[target_col]
        / capacity_kwh
    )

    # --------------------------------------------------------
    # 입력 피처 설정
    # --------------------------------------------------------

    all_target_cols = [
        col
        for col in train_df.columns
        if col.startswith("kpx_group_")
    ]

    exclude_cols = [
        TIME_COL,
        "target_cf",
        *all_target_cols
    ]

    feature_cols = [
        col
        for col in train_df.columns
        if col not in exclude_cols
    ]

    non_numeric_train_cols = (
        train_df[feature_cols]
        .select_dtypes(
            exclude=[np.number]
        )
        .columns
        .tolist()
    )

    if non_numeric_train_cols:
        raise TypeError(
            f"Group {group_id} Train에 숫자가 아닌 "
            f"피처가 있습니다:\n{non_numeric_train_cols}"
        )

    missing_test_features = [
        col
        for col in feature_cols
        if col not in test_df.columns
    ]

    if missing_test_features:
        raise KeyError(
            f"Group {group_id} Test에 Train 피처가 "
            f"누락돼 있습니다:\n{missing_test_features}"
        )

    # Test에서 Train과 같은 피처 순서 사용
    test_feature_df = test_df[
        feature_cols
    ].copy()

    non_numeric_test_cols = (
        test_feature_df
        .select_dtypes(
            exclude=[np.number]
        )
        .columns
        .tolist()
    )

    if non_numeric_test_cols:
        raise TypeError(
            f"Group {group_id} Test에 숫자가 아닌 "
            f"피처가 있습니다:\n{non_numeric_test_cols}"
        )

    # 무한대는 결측치로 변환
    # XGBoost와 LightGBM이 결측값을 자체 처리
    train_df[feature_cols] = (
        train_df[feature_cols]
        .replace(
            [np.inf, -np.inf],
            np.nan
        )
    )

    test_df[feature_cols] = (
        test_df[feature_cols]
        .replace(
            [np.inf, -np.inf],
            np.nan
        )
    )

    return {
        "group_id": group_id,
        "train_path": train_path,
        "test_path": test_path,
        "train": train_df,
        "test": test_df,
        "features": feature_cols,
        "target_col": target_col,
        "capacity_kwh": capacity_kwh
    }


group_data = {
