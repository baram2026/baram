def create_lgbm_model(
    n_estimators
):
    return LGBMRegressor(
        objective="regression_l1",

        n_estimators=int(
            max(1, n_estimators)
        ),

        learning_rate=0.03,

        num_leaves=31,
        max_depth=6,
        min_child_samples=100,

        subsample=0.8,
        subsample_freq=1,
        colsample_bytree=0.75,

        reg_alpha=0.1,
        reg_lambda=10.0,

        random_state=RANDOM_STATE,
        n_jobs=-1,

        verbosity=-1
    )


def create_base_xgb_model(
    n_estimators,
    use_early_stopping=False
):
    params = {
        "objective": "reg:squarederror",

        "n_estimators": int(
            max(1, n_estimators)
        ),

        "learning_rate": 0.03,

        "max_depth": 5,
        "min_child_weight": 10,

        "subsample": 0.8,
        "colsample_bytree": 0.75,

        "reg_alpha": 0.1,
        "reg_lambda": 10.0,

        "tree_method": "hist",
        "eval_metric": "mae",

        "random_state": RANDOM_STATE,
        "n_jobs": -1,

        "verbosity": 0
    }

    if use_early_stopping:
        params[
            "early_stopping_rounds"
        ] = 150

    return XGBRegressor(
        **params
    )


def create_group3_xgb_model(
    n_estimators,
    use_early_stopping=False
):
    """
    Group 3는 학습 기간이 상대적으로 짧으므로
    조금 더 강한 규제를 적용합니다.
    """

    params = {
        "objective": "reg:squarederror",

        "n_estimators": int(
            max(1, n_estimators)
        ),

        "learning_rate": 0.03,

        "max_depth": 4,
        "min_child_weight": 15,

        "subsample": 0.8,
        "colsample_bytree": 0.75,

        "reg_alpha": 0.1,
        "reg_lambda": 15.0,

        "tree_method": "hist",
        "eval_metric": "mae",

        "random_state": RANDOM_STATE,
        "n_jobs": -1,

        "verbosity": 0
    }

    if use_early_stopping:
        params[
            "early_stopping_rounds"
        ] = 150

    return XGBRegressor(
        **params
    )


# ============================================================
# 7. 최적 트리 수 선택 함수
# ============================================================

def select_lgbm_iterations(
    X_train,
    y_train,
    X_valid,
    y_valid,
    sample_weight=None
):
    model = create_lgbm_model(
        n_estimators=3000
    )

    model.fit(
        X_train,
        y_train,

        sample_weight=sample_weight,

        eval_set=[
            (
                X_valid,
                y_valid
            )
        ],

        eval_metric="l1",

        callbacks=[
            lgb.early_stopping(
                stopping_rounds=150,
                first_metric_only=True,
                verbose=False
            ),

            lgb.log_evaluation(
                period=0
            )
        ]
    )

    best_iteration = getattr(
        model,
        "best_iteration_",
        None
    )

    if (
        best_iteration is None
        or best_iteration <= 0
    ):
        best_iteration = 3000

    return int(
        best_iteration
    )


def select_xgb_iterations(
    X_train,
    y_train,
    X_valid,
    y_valid,
    sample_weight=None,
    group3_regularization=False
):
    if group3_regularization:
        model = create_group3_xgb_model(
            n_estimators=3000,
            use_early_stopping=True
        )

    else:
        model = create_base_xgb_model(
            n_estimators=3000,
            use_early_stopping=True
        )

    model.fit(
        X_train,
        y_train,

        sample_weight=sample_weight,

        eval_set=[
            (
                X_valid,
                y_valid
            )
        ],

        verbose=False
    )

    # XGBoost best_iteration은 0부터 시작하므로 +1
    best_iteration = getattr(
        model,
        "best_iteration",
        None
    )

    if best_iteration is None:
        return 3000

    return int(
        best_iteration + 1
    )


# ============================================================
# 8. 최종 모델 학습 함수
# ============================================================

def fit_final_lgbm(
    X_full,
    y_full,
    n_estimators,
    sample_weight=None
):
    model = create_lgbm_model(
        n_estimators=n_estimators
    )

    model.fit(
        X_full,
        y_full,
        sample_weight=sample_weight
    )

    return model


def fit_final_xgb(
    X_full,
    y_full,
    n_estimators,
    sample_weight=None,
    group3_regularization=False
):
    if group3_regularization:
        model = create_group3_xgb_model(
            n_estimators=n_estimators,
            use_early_stopping=False
        )

    else:
        model = create_base_xgb_model(
            n_estimators=n_estimators,
            use_early_stopping=False
        )

    model.fit(
        X_full,
        y_full,
        sample_weight=sample_weight,
        verbose=False
    )

    return model


