    * group2_xgb_test_prediction_cf

    + 0.50
    * group2_lgbm_test_prediction_cf,

    0,
    PREDICTION_MAX_CF
)


group2_test_prediction_kwh = (
    group2_test_prediction_cf
    * group2["capacity_kwh"]
)


# ============================================================
# 11. 글로벌 모델 피처 구조 생성
# ============================================================

# 그룹별 서로 다른 LDAPS 격자 컬럼을 모두 보존하기 위해
# 전체 피처 합집합을 사용하고, 없는 컬럼은 NaN으로 둠
global_base_features = sorted(
    set().union(
        *[
            set(
                group_data[group_id][
                    "features"
                ]
            )
            for group_id in [1, 2, 3]
        ]
    )
)


global_indicator_cols = [
    "global_group_1",
    "global_group_2",
    "global_group_3"
]


global_feature_cols = (
    global_base_features
    + global_indicator_cols
)


def make_global_features(
    source_df,
    group_id
):
    X = source_df.reindex(
        columns=global_base_features
    ).copy()

    X = X.replace(
        [np.inf, -np.inf],
        np.nan
    )

    for indicator_group in [1, 2, 3]:
        X[
            f"global_group_{indicator_group}"
        ] = float(
            group_id
            == indicator_group
        )

    return X[
        global_feature_cols
    ]


# ============================================================
# 12. 글로벌 모델의 최적 트리 수 선택
# ============================================================

global_train_X_parts = []
global_train_y_parts = []
global_train_group_ids = []

global_valid_X_parts = []
global_valid_y_parts = []


for group_id in [1, 2, 3]:

    current_group = group_data[
        group_id
    ]

    current_train_part = get_model_rows(
        current_group["train"].loc[
            current_group["train"][TIME_COL]
            < VALID_START
        ]
    )

    current_valid_part = get_model_rows(
        current_group["train"].loc[
            current_group["train"][TIME_COL]
            >= VALID_START
        ]
    )

    global_train_X_parts.append(
        make_global_features(
            source_df=current_train_part,
            group_id=group_id
        ).reset_index(drop=True)
    )

    global_train_y_parts.append(
        current_train_part[
            "target_cf"
        ].reset_index(drop=True)
    )

    global_train_group_ids.extend(
        [group_id]
        * len(current_train_part)
    )

    global_valid_X_parts.append(
        make_global_features(
            source_df=current_valid_part,
            group_id=group_id
        ).reset_index(drop=True)
    )

    global_valid_y_parts.append(
        current_valid_part[
            "target_cf"
        ].reset_index(drop=True)
    )


global_selector_X_train = pd.concat(
    global_train_X_parts,
    axis=0,
    ignore_index=True
)

global_selector_y_train = pd.concat(
    global_train_y_parts,
    axis=0,
    ignore_index=True
)

global_selector_X_valid = pd.concat(
    global_valid_X_parts,
    axis=0,
    ignore_index=True
)

global_selector_y_valid = pd.concat(
    global_valid_y_parts,
    axis=0,
    ignore_index=True
)


global_selector_weights = (
    make_equal_group_weights(
        global_train_group_ids
    )
)


global_best_iterations = (
    select_xgb_iterations(
        X_train=global_selector_X_train,
        y_train=global_selector_y_train,

        X_valid=global_selector_X_valid,
        y_valid=global_selector_y_valid,

        sample_weight=(
            global_selector_weights
        ),

        group3_regularization=False
    )
)


# 메모리 절약
del (
    global_train_X_parts,
    global_train_y_parts,
    global_train_group_ids,
    global_valid_X_parts,
    global_valid_y_parts,
    global_selector_X_train,
    global_selector_y_train,
    global_selector_X_valid,
    global_selector_y_valid,
    global_selector_weights
)


# ============================================================
# 13. 글로벌 모델 전체 데이터 재학습
# ============================================================

global_full_X_parts = []
global_full_y_parts = []
global_full_group_ids = []


for group_id in [1, 2, 3]:

    current_group = group_data[
        group_id
    ]

    current_full_train = get_model_rows(
        current_group["train"]
    )

    global_full_X_parts.append(
        make_global_features(
            source_df=current_full_train,
            group_id=group_id
        ).reset_index(drop=True)
    )

    global_full_y_parts.append(
        current_full_train[
            "target_cf"
        ].reset_index(drop=True)
    )

    global_full_group_ids.extend(
        [group_id]
        * len(current_full_train)
    )


global_full_X = pd.concat(
    global_full_X_parts,
    axis=0,
    ignore_index=True
)

global_full_y = pd.concat(
    global_full_y_parts,
    axis=0,
    ignore_index=True
)

global_full_weights = (
    make_equal_group_weights(
        global_full_group_ids
    )
)


global_final_model = fit_final_xgb(
    X_full=global_full_X,
    y_full=global_full_y,

    n_estimators=(
        global_best_iterations
    ),

    sample_weight=(
        global_full_weights
    ),

    group3_regularization=False
)


# 메모리 절약
del (
    global_full_X_parts,
    global_full_y_parts,
    global_full_group_ids,
    global_full_X,
    global_full_y,
    global_full_weights
)


# ============================================================
# 14. Group 3 전용 고출력 가중 XGBoost
# ============================================================

group3 = group_data[3]

group3_train_part = get_model_rows(
    group3["train"].loc[
        group3["train"][TIME_COL]
        < VALID_START
    ]
)

group3_valid_part = get_model_rows(
    group3["train"].loc[
        group3["train"][TIME_COL]
        >= VALID_START
    ]
)

if (
    group3_train_part.empty
    or group3_valid_part.empty
):
    raise ValueError(
        "Group 3 Train/Validation 분할이 비어 있습니다."
    )


group3_train_weights = (
    make_output_weights(
        target_cf=(
            group3_train_part["target_cf"]
        ),
        scheme=GROUP3_WEIGHT_SCHEME
    )
)


group3_best_iterations = (
    select_xgb_iterations(
        X_train=group3_train_part[
            group3["features"]
        ],

        y_train=group3_train_part[
            "target_cf"
        ],

        X_valid=group3_valid_part[
            group3["features"]
        ],

        y_valid=group3_valid_part[
            "target_cf"
        ],

        sample_weight=(
            group3_train_weights
        ),

        group3_regularization=True
    )
)


# Train + Validation 전체 재학습
group3_full_train = get_model_rows(
    group3["train"]
)

group3_full_weights = (
    make_output_weights(
        target_cf=(
            group3_full_train["target_cf"]
        ),
        scheme=GROUP3_WEIGHT_SCHEME
    )
)


group3_final_dedicated_model = (
    fit_final_xgb(
        X_full=group3_full_train[
            group3["features"]
        ],

        y_full=group3_full_train[
            "target_cf"
        ],

        n_estimators=(
            group3_best_iterations
        ),

        sample_weight=(
            group3_full_weights
        ),

        group3_regularization=True
    )
)


# ============================================================
# 15. Group 3 Test 예측
# 전용 75% + 글로벌 25%
# ============================================================

group3_dedicated_test_prediction_cf = (
    group3_final_dedicated_model.predict(
        group3["test"][
            group3["features"]
        ]
    )
)


group3_global_test_X = (
    make_global_features(
        source_df=group3["test"],
        group_id=3
    )
)


group3_global_test_prediction_cf = (
    global_final_model.predict(
        group3_global_test_X
    )
)


group3_test_prediction_cf = np.clip(
    0.75
    * group3_dedicated_test_prediction_cf

    + 0.25
    * group3_global_test_prediction_cf,

    0,
    PREDICTION_MAX_CF
)


group3_test_prediction_kwh = (
    group3_test_prediction_cf
    * group3["capacity_kwh"]
)


# ============================================================
# 16. 그룹별 Test 예측 시각 정렬
# ============================================================

group1_prediction_df = pd.DataFrame({
    TIME_COL:
        group1["test"][TIME_COL]
        .to_numpy(),

    "kpx_group_1":
        group1_test_prediction_kwh
})


group2_prediction_df = pd.DataFrame({
    TIME_COL:
        group2["test"][TIME_COL]
        .to_numpy(),

    "kpx_group_2":
        group2_test_prediction_kwh
})


group3_prediction_df = pd.DataFrame({
    TIME_COL:
        group3["test"][TIME_COL]
        .to_numpy(),

    "kpx_group_3":
        group3_test_prediction_kwh
})


prediction_df = (
    group1_prediction_df

    .merge(
        group2_prediction_df,
        on=TIME_COL,
        how="inner",
        validate="one_to_one"
    )

    .merge(
        group3_prediction_df,
        on=TIME_COL,
        how="inner",
        validate="one_to_one"
    )

    .sort_values(TIME_COL)
    .reset_index(drop=True)
)


expected_test_rows = {
    len(group1["test"]),
    len(group2["test"]),
    len(group3["test"])
}

if len(expected_test_rows) != 1:
    raise ValueError(
        "그룹별 Test 행 수가 서로 다릅니다:\n"
        f"Group 1: {len(group1['test']):,}\n"
        f"Group 2: {len(group2['test']):,}\n"
        f"Group 3: {len(group3['test']):,}"
    )


expected_rows = len(
    group1["test"]
)

if len(prediction_df) != expected_rows:
    raise ValueError(
        "그룹별 예측 시각이 완전히 일치하지 않습니다.\n"
        f"기대 행 수: {expected_rows:,}\n"
        f"병합 후 행 수: {len(prediction_df):,}"
    )


# ============================================================
# 17. sample_submission에 예측값 입력
# ============================================================

SAMPLE_SUBMISSION_PATH = find_file(
    "sample_submission.csv"
)

submission_df = pd.read_csv(
    SAMPLE_SUBMISSION_PATH,
    encoding="utf-8-sig"
)


required_submission_cols = [
    "forecast_id",
    TIME_COL,
    "kpx_group_1",
    "kpx_group_2",
    "kpx_group_3"
]

missing_submission_cols = [
    col
    for col in required_submission_cols
    if col not in submission_df.columns
]

if missing_submission_cols:
    raise KeyError(
        "sample_submission.csv에 필요한 컬럼이 없습니다:\n"
        f"{missing_submission_cols}"
    )


if submission_df[
    "forecast_id"
].duplicated().any():
    raise ValueError(
        "sample_submission의 forecast_id가 중복돼 있습니다."
    )


submission_time = pd.to_datetime(
    submission_df[TIME_COL],
    errors="raise"
)


prediction_lookup = (
    prediction_df
    .set_index(TIME_COL)
)


submission_df[
    "kpx_group_1"
] = submission_time.map(
    prediction_lookup[
        "kpx_group_1"
    ]
)


submission_df[
    "kpx_group_2"
] = submission_time.map(
    prediction_lookup[
        "kpx_group_2"
    ]
)


submission_df[
    "kpx_group_3"
] = submission_time.map(
    prediction_lookup[
        "kpx_group_3"
    ]
)


prediction_cols = [
    "kpx_group_1",
    "kpx_group_2",
    "kpx_group_3"
]


if submission_df[
    prediction_cols
].isna().any().any():

    missing_rows = submission_df.loc[
        submission_df[
            prediction_cols
        ].isna().any(axis=1),

        [
            "forecast_id",
            TIME_COL
        ]
    ]

    raise ValueError(
        "sample_submission의 일부 시각에 "
        "예측값을 연결하지 못했습니다.\n\n"
        f"{missing_rows.head(20).to_string(index=False)}"
    )


# 물리적 출력 범위 최종 확인
submission_df[
    "kpx_group_1"
] = submission_df[
    "kpx_group_1"
].clip(
    lower=0,
    upper=(
        GROUP_CONFIG[1][
            "capacity_kwh"
        ]
        * PREDICTION_MAX_CF
    )
)


submission_df[
    "kpx_group_2"
] = submission_df[
    "kpx_group_2"
].clip(
    lower=0,
    upper=(
        GROUP_CONFIG[2][
            "capacity_kwh"
        ]
        * PREDICTION_MAX_CF
    )
)


submission_df[
    "kpx_group_3"
] = submission_df[
    "kpx_group_3"
].clip(
    lower=0,
    upper=(
        GROUP_CONFIG[3][
            "capacity_kwh"
        ]
        * PREDICTION_MAX_CF
    )
)


# 제출에 필요한 5개 컬럼만 남김
submission_df = submission_df[
    required_submission_cols
]


# ============================================================
# 18. 최종 CSV 저장
# ============================================================

submission_df.to_csv(
    OUTPUT_PATH,
    index=False,
    encoding="utf-8-sig",
    float_format="%.6f"
)


print(
    f"최종 Test 예측 파일 저장 완료: "
    f"{OUTPUT_PATH}"
)
