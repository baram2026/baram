def find_file(
    filename,
    search_root=SEARCH_ROOT
):
    matches = sorted(
        search_root.rglob(filename)
    )

    if not matches:
        raise FileNotFoundError(
            f"'{filename}'을 {search_root}에서 "
            "찾지 못했습니다."
        )

    # 전처리 결과 파일은 preprocessed 폴더를 우선 선택
    preferred_matches = [
        path
        for path in matches
        if "preprocessed" in str(path).lower()
    ]

    if preferred_matches:
        matches = preferred_matches

    return matches[0]


